---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * Set by a page whose first section runs a full-bleed photograph up behind
   * the header. Only the header's own appearance changes here; the page owns
   * the image and the overlap.
   */
  heroOverlay?: boolean;
  /**
   * Hides the document scrollbar, for a page whose content is meant to read as
   * floating over a still photograph rather than sitting in a scrolling frame.
   *
   * Deliberately hides the bar and NOT the scrolling: the page still scrolls
   * the document, so the keyboard, find-in-page, and a phone's URL-bar collapse
   * all behave normally. An inner scroll container would have broken all three.
   * The cost is real and accepted — a long reference page loses its only "how
   * much is left" signal.
   */
  hideScrollbar?: boolean;
  /** Pins the navigation, so a reader deep in a long page can still leave it. */
  stickyHeader?: boolean;
}

const {
  title,
  description,
  heroOverlay = false,
  hideScrollbar = false,
  stickyHeader = false,
} = Astro.props;

// Rendered only when a page fills it, and wrapped here rather than by the page:
// `position: fixed` resolves against the viewport, so the photograph stays put
// while the document scrolls over it — which is the whole effect — and only the
// layout can place an element outside the page's own section.
const hasBackdrop = Astro.slots.has('backdrop');
---

<html lang="he" dir="rtl" class:list={[hideScrollbar && 'no-scrollbar']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:locale" content="he_IL" />
    {Astro.site && (
      <>
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
        <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
      </>
    )}
    {/* No og:image yet — there is no artwork for it. Outstanding until Aviv supplies real
        assets (design spec §10/§14); a link shared to WhatsApp will render title/description
        text only until then. */}
  </head>
  <body class="min-h-screen flex flex-col">
    {
      hasBackdrop && (
        <div class="fixed inset-0" aria-hidden="true">
          <slot name="backdrop" />
        </div>
      )
    }
    {/*
      `relative` on both, so they paint above the fixed backdrop by document
      order instead of by a negative z-index on the photograph — a negative one
      would also have to beat the page's own sand background, which is a fight
      that depends on which element the browser propagated it from. `Header`
      already carries `relative z-10` for the homepage's overlap.
    */}
    <Header overBackdrop={heroOverlay} sticky={stickyHeader} />
    <main class:list={['flex-1', hasBackdrop && 'relative']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
