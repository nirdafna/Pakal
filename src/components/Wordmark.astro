---
/**
 * The פק"ל brand mark, per the approved mockup: navy wordmark with a green
 * location pin set into the bowl of the פ, card suits beneath, and the tagline
 * over a brush stroke.
 *
 * Built from text and inline SVG rather than an image file. Aviv's logo
 * artwork does not exist yet, and a text mark stays selectable, scales without
 * a second asset request, and lets the CMS override the wording. Swapping in
 * real artwork later means replacing this component, not every caller.
 *
 * No `style` attributes anywhere: CSP blocks them (see `global.css`), so
 * everything here is a utility class generated from the `@theme` tokens.
 */
interface Props {
  /** Defaults to the brand name; CMS `heroTitle` overrides it. */
  title?: string;
  /** Defaults to the brand tagline; CMS `heroTagline` overrides it. */
  tagline?: string;
  /**
   * `sm` is the navigation mark, `md` the same mark given more presence in the
   * homepage's header, `lg` the hero mark.
   */
  size?: 'sm' | 'md' | 'lg';
  /** Card suits sit under the header mark, not the hero one, as in the mockup. */
  suits?: boolean;
  /** Renders the wordmark as the page's `h1` instead of a plain span. */
  heading?: boolean;
}

const {
  title = 'פק"ל',
  tagline = 'נהנים בכל דרך',
  size = 'sm',
  suits = size !== 'lg',
  heading = false,
} = Astro.props;

// The pin sits inside the bowl of the פ — the enclosed counter is the only
// place in the wordmark with room for it, which is why the mockup puts it
// there. Splitting on the first פ ties the pin to the glyph rather than to a
// hard-coded offset, so it survives a font change, and a CMS title with no פ
// renders without a pin instead of putting one somewhere arbitrary.
const pinIndex = title.indexOf('פ');
const before = pinIndex === -1 ? title : title.slice(0, pinIndex);
const after = pinIndex === -1 ? '' : title.slice(pinIndex + 1);

// One row per size rather than a chain of ternaries: the mark has five things
// that scale together, and reading a size down a column is how you check they
// still agree.
//
// The pin and the brush are em-relative, so they follow the wordmark's own type
// size instead of needing their own numbers per row. They are the two knobs
// worth nudging if the mark ever changes typeface: the offset drops the pin into
// the counter of the פ, and the width keeps it clear of the surrounding strokes.
const scale = {
  sm: { wordmark: 'text-2xl', tagline: 'text-xs', suit: 'text-[0.7rem]', pin: 'w-[0.22em]', brush: 'h-1' },
  md: { wordmark: 'text-4xl', tagline: 'text-sm', suit: 'text-[0.95rem]', pin: 'w-[0.21em]', brush: 'h-1.5' },
  lg: { wordmark: 'text-6xl sm:text-7xl', tagline: 'text-2xl sm:text-3xl', suit: 'text-lg', pin: 'w-[0.19em]', brush: 'h-2' },
}[size];

const { wordmark: wordmarkSize, tagline: taglineSize, suit: suitSize, pin: pinSize, brush: brushHeight } = scale;
const pinOffset = 'top-[0.44em]';
const Tag = heading ? 'h1' : 'span';
---

<span class="inline-block w-fit">
  <Tag class={`block font-bold leading-none text-brand ${wordmarkSize}`}>
    {before}
    {
      pinIndex !== -1 && (
        <span class="relative inline-block">
          פ
          <svg
            class={`absolute inset-x-0 mx-auto text-cta ${pinOffset} ${pinSize}`}
            viewBox="0 0 24 32"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 0C5.4 0 0 5.4 0 12c0 8.4 12 20 12 20s12-11.6 12-20c0-6.6-5.4-12-12-12zm0 16.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"
            ></path>
          </svg>
        </span>
      )
    }
    {after}
  </Tag>

  {
    suits && (
      <span class={`mt-1 flex justify-center gap-1 leading-none ${suitSize}`} aria-hidden="true">
        <span class="text-brand">&#9827;</span>
        <span class="text-accent">&#9830;</span>
        <span class="text-accent">&#9829;</span>
        <span class="text-brand">&#9824;</span>
      </span>
    )
  }

  <!--
    The brush is positioned absolutely, not merely decorated: an inline SVG with
    no width or height attribute falls back to the replaced-element default of
    300x150px, and inside a shrink-to-fit box that default becomes the width of
    the entire mark. Taking it out of flow lets the wordmark size itself from
    the type, which is what it looked like it was doing until the header showed
    a 300px-wide logo.
  -->
  <span class="relative mt-1 block pb-1">
    <span class={`block text-center font-light leading-tight text-brand ${taglineSize}`}>
      {tagline}
    </span>
    <svg
      class={`absolute inset-x-0 bottom-0 w-full text-brand ${brushHeight}`}
      viewBox="0 0 200 8"
      preserveAspectRatio="none"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M2 6C40 2.5 78 1.4 116 2.2c28 .6 56 2 82 3.4"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
      ></path>
    </svg>
  </span>
</span>
