---
const year = new Date().getFullYear();
---

<!--
  `relative` for the same reason `Header` carries it: a page-level fixed
  backdrop is painted first, and a positioned element beats it by document
  order. Costs the other pages nothing.
-->
<footer class="relative border-t border-black/10 px-4 py-8 text-sm">
  <div class="mx-auto flex max-w-6xl flex-wrap gap-4">
    <p>פק"ל — נהנים בכל דרך</p>
    <p class="ms-auto bidi-isolate">© {year}</p>
  </div>
</footer>
