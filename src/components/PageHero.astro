---
import HeroBackdrop from './HeroBackdrop.astro';
import type { SanityImage as SanityImageType } from '../lib/sanity/types';

/**
 * The homepage's opening treatment, cut down for an inner page: the same
 * photograph running behind the header, the same scrim, the same right-attached
 * column — in a band rather than a full screen.
 *
 * A full screen is wrong here and was the option rejected at mockup. Someone
 * arriving at the instructions has come to read the rules, usually after
 * scanning a printed card outdoors; making them scroll a viewport of scenery
 * first is brand continuity bought with the reader's time.
 *
 * `-mt-28 pt-28` is the same cancelling pair the homepage uses: the photograph
 * has to run behind the header, which `BaseLayout` renders above the page slot
 * and the page cannot reach. Pull the section up by the header's height, pad
 * the contents back down by the same amount, and neither element needs to know
 * the other's size. Pages using this must pass `heroOverlay` to `BaseLayout`,
 * which is what drops the header's divider — a hairline ruled across a photo
 * reads as a rendering defect.
 */
interface Props {
  title: string;
  lead?: string;
  image?: SanityImageType;
}

const { title, lead, image } = Astro.props;
---

<section
  class="relative isolate -mt-28 flex min-h-112 flex-col overflow-hidden bg-sand pt-28"
>
  <HeroBackdrop image={image} priority focus="object-[center_35%]" />

  <div class="mx-auto flex w-full max-w-6xl flex-1 items-center px-4 py-10">
    <div class="max-w-xl">
      <h1 class="text-4xl font-bold leading-tight text-brand sm:text-5xl">{title}</h1>
      {/* The shorter measure keeps the line endings off the busiest part of the
          photograph, the same reason the homepage's lead carries it. */}
      {lead && <p class="mt-4 max-w-md text-lg">{lead}</p>}
    </div>
  </div>
</section>
