---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import PageHero from '../components/PageHero.astro';
import PortableText from '../components/PortableText.astro';
import { splitIntoSections } from '../lib/portable-text';
import { getPage, getSiteSettings } from '../lib/sanity/queries';

const [page, settings] = await Promise.all([getPage('how-to-play'), getSiteSettings()]);

const description = 'חוקי המשחק והדרכים לשחק בחפיסת פק"ל.';
const sections = splitIntoSections(page?.body);
---

<BaseLayout title='איך משחקים — פק"ל' description={description} heroOverlay hideScrollbar>
  <!--
    The photograph fills the viewport and stays there. The layout fixes this
    slot, so the picture holds still — edge to edge, behind the header and out
    past both sides of the text column — while the cards travel over it. That
    stillness, plus the hidden scrollbar, is what makes the rules read as
    floating on the page rather than sitting in a scrolling frame.
  -->
  <Fragment slot="backdrop">
    <HeroBackdrop image={settings?.heroImage} priority focus="object-[center_35%]" wash="page" />
  </Fragment>

  <PageHero title={page?.title ?? 'איך משחקים'} lead={description} />

  <!--
    One card per numbered rule section rather than one card around all ninety
    blocks. The page is a reference, not an essay: a reader looking up what a
    queen does wants to find that section, and a stack of separated cards is
    scannable in a way an unbroken column is not.

    A body with no `h2` comes back from `splitIntoSections` as a single group,
    so any other CMS page rendered through here still gets the old single
    container without a special case.
  -->
  <section class="mx-auto max-w-3xl px-4 pb-16 pt-6">
    {
      sections.length > 0 ? (
        <div class="flex flex-col gap-4">
          {sections.map((blocks) => (
            <article class="rounded-xl bg-sand p-6 shadow-sm sm:p-8">
              <PortableText value={blocks} />
            </article>
          ))}
        </div>
      ) : (
        <p>התוכן בהכנה ויעלה בקרוב.</p>
      )
    }
  </section>
</BaseLayout>
