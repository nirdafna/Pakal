---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Wordmark from '../components/Wordmark.astro';
import PlaceCard from '../components/PlaceCard.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import { getPlaces, getSiteSettings } from '../lib/sanity/queries';

const settings = await getSiteSettings();
const places = await getPlaces(3);

const heroTitle = settings?.heroTitle ?? 'פק"ל';
const heroTagline = settings?.heroTagline ?? 'נהנים בכל דרך';
const heroText =
  settings?.heroText ??
  'משחק קלפים משפחתי כחול-לבן שמחבר בין משחקים אהובים, אתרים בישראל וחוויות טיול לכל המשפחה.';

const features = [
  {
    title: 'סרקו וצאו לדרך',
    body: 'סרקו את הקוד שבגב הקלף וקבלו גישה מהירה למסלולים, מידע והשראה לטיול הבא.',
  },
  { title: 'מטיילים באמת', body: 'כל קלף מחבר אתכם לאתר או מסלול בארץ, עם הסברים, טיפים והמלצות.' },
  {
    title: 'משחק פק"ל המקורי',
    body: 'קלפי פעולה, דמויות משפחת מטיילים וחוקים ייחודיים לחוויה משפחתית מלאת הפתעות.',
  },
  { title: 'משחקים מוכרים', body: 'שחקו מלחמה, רמי ומשחקי קלפים אהובים עם חפיסה איכותית ומיוחדת.' },
];
---

<BaseLayout title='פק"ל — נהנים בכל דרך' description={heroText} heroOverlay>
  <!--
    One full viewport of photograph carrying the header, the copy and the four
    feature cards, exactly as the approved mockup lays it out.

    `-mt-28 pt-28`: the image has to run behind the header, but the header is
    rendered by the layout above this slot and cannot be reached from here.
    Pulling the section up by the header's height and padding its contents back
    down by the same amount puts the photograph under the navigation without
    either element having to know the other's size — and because the two values
    cancel, error in the value moves nothing — it only has to be at least the
    header's height, and 7rem leaves room for the header to grow. `Header`
    carries `relative z-10` so the nav still paints above the image.

    Two states share this markup: with a published `heroImage` the photo fills
    the screen, and without one the same layout falls back to the sand ground.
    Publishing the photo is a content action, not a code change. How the
    photograph itself is treated lives in `HeroBackdrop`, shared with the inner
    pages so the two cannot drift apart.
  -->
  <section class="relative isolate -mt-28 flex min-h-svh flex-col overflow-hidden bg-sand pt-28">
    <HeroBackdrop image={settings?.heroImage} priority />

    <div class="mx-auto flex w-full max-w-6xl flex-1 items-center px-4 py-10">
      {/*
        A column held against the inline-start edge — the right, in an RTL
        document — so the copy sits clear of the box and cards on the left of
        the photograph instead of on top of them.
      */}
      <div class="max-w-xl">
        <Wordmark title={heroTitle} tagline={heroTagline} size="lg" heading />
        {/* A shorter measure than the column: it pulls the line endings back
            off the QR code in the photograph, and 45-ish characters is an
            easier read than the full 576px anyway. */}
        <p class="mt-8 max-w-md text-lg">{heroText}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          {
            settings?.whatsappPhone && (
              <WhatsAppCta
                phone={settings.whatsappPhone}
                message={settings.purchaseMessage ?? 'היי, אשמח לפרטים על רכישת המשחק'}
                label="לרכישת המשחק"
                icon="bag"
              />
            )
          }
          <a
            href="/treks"
            class="inline-flex items-center gap-2 rounded-lg border-2 px-6 py-3 font-semibold border-brand text-brand"
          >
            <svg class="w-5" viewBox="0 0 24 32" fill="currentColor" aria-hidden="true">
              <path
                d="M12 0C5.4 0 0 5.4 0 12c0 8.4 12 20 12 20s12-11.6 12-20c0-6.6-5.4-12-12-12zm0 16.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z"
              />
            </svg>
            למסלולים שבחפיסה
          </a>
        </div>
        <p class="mt-4"><a class="underline" href="/how-to-play">איך משחקים?</a></p>
      </div>
    </div>

    <div class="mx-auto w-full max-w-6xl px-4 pb-10">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {features.map((feature) => <FeatureCard title={feature.title} body={feature.body} />)}
      </div>
    </div>
  </section>

  {
    places.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
        <h2 class="text-2xl font-bold">מהמסלולים שבחפיסה</h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-3">
          {places.map((place) => (
            <li>
              <PlaceCard place={place} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
